# Confluent Cloud API key (Cloud resource management, not a cluster key).
# The owning principal needs OrganizationAdmin to manage certificate
# authorities and identity pools.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# AWS credentials for the VPC, PrivateLink endpoint and client host.
# Any standard AWS credential source works; a named profile is simplest.
AWS_PROFILE=
